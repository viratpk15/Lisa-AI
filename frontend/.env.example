# ============================================================
# Lisa-AI v1.0 — Frontend Client Environment Configuration
# ============================================================
# Copy this file to .env or set environment variables in Vercel.

# Base URL for the FastAPI backend API
# Example for local development: http://127.0.0.1:8000
# Example for production Render backend: https://lisa-ai-backend.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Default Timeout (in milliseconds) for HTTP network requests
VITE_API_TIMEOUT_MS=10000
