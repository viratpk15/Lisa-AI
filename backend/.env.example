# Jarvis AIOS Environment Configuration
# -------------------------------------
# Copy this file to .env and update values for your environment.
# NEVER commit actual secrets to version control.

# LLM API Key (required for chat functionality)
GROQ_API_KEY=

# JWT Secret Key (required for authentication)
# Generate a secure random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Optional: JWT configuration
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ============================================================
# Database Provider
# sqlite (development)
# postgres (production)
# ============================================================


# Optional: Custom database paths for testing
AUTH_DB_PATH=./data/auth.db
PERSISTENCE_DB_PATH=./data/memory.db


DATABASE_PROVIDER=sqlite

DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=

# ============================================================
# Local SQLite
# (used only when DATABASE_PROVIDER=sqlite)
# ============================================================


# Development
# DATABASE_PROVIDER=sqlite

# Production
# DATABASE_PROVIDER=postgres


SEARCH_PROVIDER=auto

SERPER_API_KEY=
TAVILY_API_KEY=

# Search subsystem tuning
SEARCH_TIMEOUT=15
SEARCH_CACHE_TTL=300
SEARCH_MAX_RESULTS=5

WEATHER_PROVIDER=open-meteo