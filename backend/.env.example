# ============================================================
# Lisa-AI v1.0 — Backend Production Environment Configuration
# ============================================================
# Copy this file to .env and set secret values for production deployment.
# NEVER commit production secrets or real API keys to git.

# ------------------------------------------------------------
# Environment & Runtime Mode
# ------------------------------------------------------------
# Mode: "development" (default) or "production"
# - In "development": Groq -> NVIDIA NIM -> Mistral -> Ollama (LOCAL ONLY)
# - In "production":  Groq -> NVIDIA NIM -> Mistral (Ollama strictly excluded)
ENVIRONMENT=development

# ------------------------------------------------------------
# LLM Provider Configuration & Failover Strategy
# ------------------------------------------------------------
# Primary Provider (P1): Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Secondary Provider (P2): NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Tertiary Provider (P3): Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Local Offline Development Fallback (P4 - DEVELOPMENT ONLY, NEVER IN PRODUCTION)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b


# ------------------------------------------------------------
# Authentication & JWT Security
# ------------------------------------------------------------
# Secret key used to sign HS256 JWT access tokens (REQUIRED for auth)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT Signing algorithm and token expiry (in hours)
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Set to true ONLY in local dev environments if guest admin bypass is required
ALLOW_DEV_GUEST_TOKEN=false

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------
# Database Provider: "sqlite" (development default) or "postgres" (production / Supabase)
DATABASE_PROVIDER=sqlite

# PostgreSQL Connection String (required when DATABASE_PROVIDER=postgres)
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Supabase Credentials (optional / PostgreSQL management)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local SQLite Database Paths (used when DATABASE_PROVIDER=sqlite)
AUTH_DB_PATH=./data/auth.db
PERSISTENCE_DB_PATH=./data/memory.db

# ------------------------------------------------------------
# Network & Server Settings
# ------------------------------------------------------------
# Host and Port settings (Render sets PORT automatically)
PORT=8000

# Application Version tag
APP_VERSION=1.0.0

# CORS Allowed Origins (comma-separated list of origins)
# Example for Vercel: https://lisa-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Rate Limiting Parameters (slowapi)
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
CHAT_RATE_LIMIT=30/minute

# ------------------------------------------------------------
# Search Subsystem Configuration
# ------------------------------------------------------------
# Provider: "auto" | "serper" | "tavily" | "brave" | "fallback"
SEARCH_PROVIDER=auto

# API Keys for live search providers
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARCH_API_KEY=

# Search tuning
SEARCH_TIMEOUT=15
SEARCH_CACHE_TTL=300
SEARCH_MAX_RESULTS=5

# ------------------------------------------------------------
# Additional Integration Tuning
# ------------------------------------------------------------
WEATHER_PROVIDER=open-meteo
RAG_MIN_CONFIDENCE=0.20

# ------------------------------------------------------------
# Google OAuth 2.0 & Gmail Integration
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ------------------------------------------------------------
# Job & Internship Aggregator APIs (India & Global)
# ------------------------------------------------------------
# 1. Adzuna Job Search API (Free API for India & Global: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 2. JSearch API via RapidAPI (Google Jobs & Internships for India: https://rapidapi.com/letscrape-6bRwv3Process/api/jsearch)
RAPIDAPI_KEY=
JSEARCH_API_KEY=

# 3. Jooble Job Search API (Free API for India: https://jooble.org/api/about)
JOOBLE_API_KEY=